\outl0\strokewidth0 \strokec2 #!/usr/bin/env python3\
"""\
Step 8: validation vs test metrics for the trial-19 checkpoint (all 15 tracks pooled), in the style of\
scripts/T2_evaluating/compare_valid_test.py (which did this for the top-3 trials of each coverage-sweep subset).\
\
Validation: final_metrics.json written at the end of training (best epoch, validation split).\
Test:       summary.json of step 7 (FOLD_3 test windows, full 1 Mb window).\
\
Count r is computed the way validation computes it: Pearson r of region totals per track, averaged over tracks.\
The evaluation script's summary.json instead pools all region x track totals into one r, which also rewards\
getting the differences between tracks right; it is kept in the CSV as a separate row for reference. The\
per-track values come from the region totals saved in ft_metrics.pkl (region-major, tracks inner).\
Writes valid_vs_test.csv and valid_vs_test.png/.pdf to <out-dir>.\
"""\
\
import argparse\
import json\
import pickle\
from pathlib import Path\
\
import matplotlib\
matplotlib.use("Agg")\
import matplotlib.pyplot as plt\
import numpy as np\
import pandas as pd\
\
REPO = Path("/srv/scratch/wonglab/minh/alphagenome")\
OUT = REPO / "result_files/T3_evaluating/insertion_trial19/valid_test"\
METRICS = [  # (label, validation key suffix, test key)\
    ("Profile r (mean)", "profile", "profile_pearson_r_mean"),\
    ("Count r", "count", "count_pearson_r"),\
    ("RMSLE", "count_rmsle", "region_rmsle"),\
]\
PALETTE = \{"Validation": "#B0BEC5", "Testing": "#4575b4"\}  # as in compare_valid_test.py\
\
\
def parse_args():\
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\
    p.add_argument("--val-json", default=str(REPO / "result_files/T2_fine_tuning/sweep_checkpoints_insertion/"\
                                                    "sweep_trial_19_all_15/final_metrics.json"))\
    p.add_argument("--test-json", default=str(OUT / "test_eval/summary.json"))\
    p.add_argument("--test-pkl", default=None, help="ft_metrics.pkl of the test run (default: next to --test-json)")\
    p.add_argument("--out-dir", default=str(OUT))\
    p.add_argument("--label", default="Insertion sweep trial 19 (all 15)")\
    return p.parse_args()\
\
\
def per_track_count_r(metrics: dict) -> float:\
    """Mean over tracks of the Pearson r between predicted and observed region totals (as in validation)."""\
    n = metrics["n_regions"]\
\
    pred = np.asarray(metrics["_pred_counts"]).reshape(n, -1)\
    true = np.asarray(metrics["_target_counts"]).reshape(n, -1)\
    return float(np.mean([np.corrcoef(pred[:, k], true[:, k])[0, 1] for k in range(pred.shape[1])]))\
\
\
def main():\
    args = parse_args()\
    val = json.loads(Path(args.val_json).read_text())\
    test = json.loads(Path(args.test_json).read_text())["finetuned"]\
    pkl_path = Path(args.test_pkl) if args.test_pkl else Path(args.test_json).with_name("ft_metrics.pkl")\
    with open(pkl_path, "rb") as f:\
        test_raw = pickle.load(f)\
    rows = []\
    for res in ("1", "128"):\
        test_values = \{tkey: test[res][tkey] for _, _, tkey in METRICS\}\
        test_values["count_pearson_r"] = per_track_count_r(test_raw[int(res)])\
        for label, vkey, tkey in METRICS:\
            rows.append(\{"Resolution": f"\{res\}bp", "Metric": label,\
                         "Validation": val[f"\{res\}bp_\{vkey\}"], "Testing": test_values[tkey]\})\
        rows.append(\{"Resolution": f"\{res\}bp", "Metric": "Count r (pooled over tracks, test only)",\
                     "Validation": np.nan, "Testing": test[res]["count_pearson_r"]\})\
    df = pd.DataFrame(rows)\
    out = Path(args.out_dir)\
    out.mkdir(parents=True, exist_ok=True)\
    df.to_csv(out / "valid_vs_test.csv", index=False)\
    print(df.round(4).to_string(index=False))\
\
    plt.rcParams.update(\{"font.size": 12, "axes.spines.top": False, "axes.spines.right": False\})\
    fig, axes = plt.subplots(2, 3, figsize=(13, 8))\
    for i, res in enumerate(("1bp", "128bp")):\
        for j, (label, _, _) in enumerate(METRICS):\
            ax = axes[i, j]\
            r = df[(df.Resolution == res) & (df.Metric == label)].iloc[0]  # Count r = per-track mean\
            bars = ax.bar(["Validation", "Testing"], [r.Validation, r.Testing],\
                          color=[PALETTE["Validation"], PALETTE["Testing"]], edgecolor="white", linewidth=1.5)\
            ax.bar_label(bars, fmt="%.3f", padding=3)\
            lo, hi = sorted([r.Validation, r.Testing])\
            pad = max(hi - lo, 0.02 * hi)\
            ax.set_ylim(max(0, lo - 3 * pad), hi + 2 * pad)\
            ax.grid(axis="y", linestyle="--", alpha=0.3)\
            if i == 0:\
                ax.set_title(label + (" (per-track mean)" if label == "Count r" else ""), fontweight="bold")\
            if j == 0:\
                ax.set_ylabel(f"\{res\} score", fontweight="bold")\
    fig.suptitle(f"Validation vs test: \{args.label\}", fontweight="bold")\
    fig.tight_layout()\
    for ext in ("png", "pdf"):\
        fig.savefig(out / f"valid_vs_test.\{ext\}", dpi=300)\
    print(f"Written \{out\}/valid_vs_test.png/.pdf and .csv")\
\
\
if __name__ == "__main__":\
    main()\
}