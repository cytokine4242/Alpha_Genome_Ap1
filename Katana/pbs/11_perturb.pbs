#!/bin/bash
#PBS -N ag_perturb
#PBS -l select=1:ncpus=6:mem=96gb:ngpus=1:gpu_model=H200
#PBS -l walltime=12:00:00
#PBS -j oe
# Array job: qsub -J 0-N-1 -v SITES=cm,NCHUNKS=N (see submit_all.sh). SITES = cm or fb.
source "$PBS_O_WORKDIR/pbs/common.sh"
CHUNK=${PBS_ARRAY_INDEX:-0}
python 11_perturb_sites.py --sites ../data/${SITES}_fos_sites.csv --out ../results/${PREFIX}${SITES} \
    --chunk $CHUNK --n-chunks ${NCHUNKS:-1} ${KINDS:+--kinds $KINDS} ${LIMIT:+--limit $LIMIT}
