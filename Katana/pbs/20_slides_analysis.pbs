# CPU-only: the analyses behind the two lab-meeting slides (no GPU, general queue): qsub pbs/20_slides_analysis.pbs
cd $PBS_O_WORKDIR
source pbs/queue_wait.sh 2>/dev/null
source /srv/scratch/wonglab/minh/envs/alphagenome-pytorch_venv/bin/activate
cd ..
